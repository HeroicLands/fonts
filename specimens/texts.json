        "hl-thuravark-carved": {
            "tongue": "Nordmal",
            "source": {
                "note": "assets/content/Skills/Languages/Nordmal.md",
                "title": "Nordmal Language",
                "section": "Sample Phrases"
            },
            "lines": [
                {
                    "script": "U+F0109 U+F0101 U+F0110 U+F0111 U+F0113 U+F0100 U+F010C U+F0106 U+0020 U+F010B U+F0100 U+F010C U+F010C U+F0100 U+F0110 U+0020 U+F0112 U+F0102 U+F0125 U+F0102 U+F0112 U+F0140",
                    "roman": "Hersvald kallar tingit.",
                    "english": "The host-wielder calls the assembly."
                },
                {
                    "script": "U+F0113 U+F0101 U+F0110 U+0020 U+F0108 U+F0100 U+F0125 U+F0104 U+F010D U+0020 U+F0102 U+F0148 U+0020 U+F0107 U+F0110 U+F0102 U+F0106 U+F0102 U+F0140",
                    "roman": "Ver gangum í fridi.",
                    "english": "We come in peace."
                },
                {
                    "script": "U+F0120 U+F0110 U+F0104 U+F010E U+F0113 U+F0100 U+F010C U+F0106 U+0020 U+F0113 U+F0100 U+F010B U+F0102 U+F0110 U+0020 U+F0104 U+F010C U+F0107 U+F0100 U+F0110 U+0020 U+F0120 U+F0102 U+F0110 U+F0111 U+F0112 U+F0100",
                    "roman": "Thrunvald vakir, ulfar thyrsta!",
                    "english": "The Thunder-Wielder wakes, the wolves thirst!"
                },
                {
                    "script": "U+F0112 U+F0113 U+F0100 U+F0104 U+0020 U+F0111 U+F010B U+F0102 U+F010F U+0020 U+F0101 U+F0102 U+F010E U+0020 U+F0107 U+F0101 U+F0110 U+F0106 U+F0140",
                    "roman": "Tvau skip, ein ferd.",
                    "english": "Two ships, one voyage."
                },
                {
                    "script": "U+F0111 U+F0112 U+F0103 U+F0148 U+F0110 U+F0100 U+F010C U+F0106 U+F0102 U+F0112 U+0020 U+F010C U+F0102 U+F0107 U+F0102 U+F0110 U+0020 U+F0102 U+F0148 U+0020 U+F0111 U+F0112 U+F0101 U+F0102 U+F010E U+F0102 U+0020 U+F0103 U+F010B U+0020 U+F0102 U+F0148 U+0020 U+F010D U+F0102 U+F010E U+F010E U+F0102 U+F0140",
                    "roman": "Stóraldit lifir í steini ok í minni.",
                    "english": "The saga lives in stone and in memory."
                }
            ],
            "marks_note": "A vowel with the acute is cut as its stave twice. The crown open and crown close frame the name of a god between them.",
            "marks": [
                {
                    "label": "i with the acute",
                    "script": "U+F0102 U+F0148"
                },
                {
                    "label": "o with the acute",
                    "script": "U+F0103 U+F0148"
                },
                {
                    "label": "a with the acute",
                    "script": "U+F0100 U+F0148"
                },
                {
                    "label": "Thrunvald, crowned",
                    "script": "U+F0150 U+F0120 U+F0110 U+F0104 U+F010E U+F0113 U+F0100 U+F010C U+F0106 U+F0151"
                }
            ]
        },
        "hl-semaron-kuriale": {
            "tongue": "Vylari",
            "source": {
                "note": "assets/content/Lore/Cultures/Vylarian/The_Walking_of_the_Line.md",
                "title": "The Walking of the Line",
                "section": "lines 1–4"
            },
            "lines": [
                {
                    "script": "U+F0251 U+F0237 U+F023F U+F0242 U+F0250 U+F023F U+F0237 U+F023B U+F0230 U+F023C U+0020 U+F0240 U+F023D U+F023F U+F0237 U+F023B U+F0230 U+F023B U+F0233 U+F023C U+F0268",
                    "roman": "Thiruthriman sorimamen,",
                    "english": "The hallowed boundary I sing,"
                },
                {
                    "script": "U+F0242 U+F023A U+0020 U+F0230 U+F023A U+F0230 U+F0250 U+F0230 U+F0240 U+0020 U+F0239 U+F0233 U+F0232 U+F0237 U+F0240 U+0020 U+F0230 U+F023A U+F0230 U+F0250 U+F0230 U+0020 U+F0243 U+F0230 U+F023A U+F023B U+F0230 U+F0246 U+F023D U+F023F U+F0268 U+0020 U+F0242 U+F023A U+0020 U+F0241 U+F0230 U+F023A U+F023D U+F0250 U+F023D U+F0237",
                    "roman": "ul alathas kedis alatha valmazor, ul talothoi",
                    "english": "and the one who walked it, and the stones"
                },
                {
                    "script": "U+F023A U+F0233 U+F023C U+F0232 U+F0250 U+F023D U+F0237 U+0020 U+F0237 U+F023F U+0020 U+F0245 U+F023D U+F023F U+F023B U+F0230 U+F023A U+F0237 U+F0240 U+0020 U+F023D U+F023A U+0020 U+F0240 U+F0233 U+F023A U+F0250 U+F0242 U+F023F U+0020 U+F023B U+F0230 U+F023A U+F0239 U+F023D U+F0250 U+F023D U+F0237",
                    "roman": "lendthoi ir yormalis ol selthur malkothoi",
                    "english": "set down in the grass of the six hills"
                },
                {
                    "script": "U+F023E U+F023F U+F0230 U+0020 U+F0239 U+F0233 U+F023B U+F0231 U+F023D U+F0250 U+F023D U+F0240 U+0020 U+F0242 U+F0240 U+0020 U+F0242 U+F023F U+F0239 U+F0237 U+F0240 U+0020 U+F023D U+F023A U+0020 U+F0230 U+F023A U+F0230 U+F0250 U+F023D U+F0237 U+0020 U+F0250 U+F0230 U+F023A U+F0233 U+F0246 U+F023D U+F023F U+F0268",
                    "roman": "pra kembothos us urkis ol alathoi thalezor.",
                    "english": "before a wall stood on any of them."
                }
            ],
            "marks_note": "The catch, a glottal stop, is a grave stroke over the letter it follows.",
            "marks": [
                {
                    "label": "a with the catch",
                    "script": "U+F0230 U+F0270"
                },
                {
                    "label": "o with the catch",
                    "script": "U+F023D U+F0270"
                },
                {
                    "label": "e with the catch",
                    "script": "U+F0233 U+F0270"
                },
