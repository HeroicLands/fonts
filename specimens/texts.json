                    "script": "U+F0242 U+F0270"
                }
            ]
        },
        "hl-helonika-book": {
            "tongue": "Helonic",
            "source": {
                "note": "assets/content/Skills/Languages/Helonic.md",
                "title": "Helonic Language",
                "section": "Sample Phrases"
            },
            "lines": [
                {
                    "script": "U+F0312 U+F033E U+F0344 U+F0338 U+F0341 U+F0330 U+0020 U+F0333 U+F0342 U+F0330 U+F0341 U+F0338 U+F033D U+0020 U+F0330 U+F0341 U+F033A U+F0337 U+F0338 U+F0332 U+F0337 U+F0338 U+F033D U+0020 U+F0340 U+F033B U+F0345 U+F033C U+F033E U+F033D",
                    "roman": "Sothira ésarin arkhidhin plumon",
                    "english": "Wisdom is the beginning of all things"
                },
                {
                    "script": "U+F0300 U+F0344 U+0020 U+F033A U+F0333 U+F033B U+F0338 U+F0341 U+F0330 U+F033D U+0020 U+F0344 U+F0333 U+F0341 U+F0330 U+F0332 U+F0337 U+F0338 U+F033D U+0020 U+F0333 U+F0342 U+F0330 U+F0341 U+F0338 U+F033D U+0020 U+F0344 U+F0330 U+F0342 U+F0338 U+F0341 U+F033E U+F033D",
                    "roman": "Ath kéliran théradhin ésarin thásiron",
                    "english": "To behold beauty is divine"
                },
                {
                    "script": "U+F0311 U+F0337 U+F0333 U+F0344 U+F0330 U+F0342 U+F0338 U+F033D U+0020 U+F0332 U+F0337 U+F0338 U+F0332 U+F0330 U+F033A U+F0337 U+F0338 U+F0341",
                    "roman": "Rhéthasin, dhidakhir!",
                    "english": "Speak, teach!"
                },
                {
                    "script": "U+F030C U+F0333 U+F0344 U+F0330 U+F0341 U+F0338 U+F033D U+0020 U+F0344 U+F033E U+F0338 U+F0341 U+0020 U+F0340 U+F033B U+F0345 U+F033C U+F033E U+F033D U+0020 U+F0333 U+F0342 U+F0330 U+F0341 U+F0338 U+F033D U+0020 U+F0330 U+F033D U+F0344 U+F0338 U+F033C U+F033E U+F0341",
                    "roman": "Métharin thoir plumon ésarin ánthimor",
                    "english": "Man is the measure of all things"
                },
                {
                    "script": "U+F030E U+F033B U+F0330 U+F0342 U+F0338 U+F033D U+0020 U+F033A U+F033E U+F0342 U+F0330 U+F033C U+F0338 U+F0341 U+0020 U+F0338 U+F033D U+0020 U+F033B U+F0333 U+F033A U+F0337 U+F0338 U+F0342 U+F0338 U+F0341",
                    "roman": "Olasin kosamir in lékhisir",
                    "english": "The entire cosmos in a single word"
                }
            ],
            "marks_note": "The accent stands over the vowel before it; the long vowels carry their length bar as letters of their own.",
            "marks": [
                {
                    "label": "a with the accent",
                    "script": "U+F0330 U+F0378"
                },
                {
                    "label": "e with the accent",
                    "script": "U+F0333 U+F0378"
                },
                {
                    "label": "o with the accent",
                    "script": "U+F033E U+F0378"
                },
                {
                    "label": "long a, i and u, with the length bar",
                    "script": "U+F0350 U+F0351 U+F0352"
                },
                {
                    "label": "long e and long o",
                    "script": "U+F0334 U+F033F"
                }
            ]
        },
        "hl-vedyakshara-classical": {
            "tongue": "Vedyari",
            "source": {
                "note": "assets/content/Skills/Languages/Vedyari.md",
                "title": "Vedyari Language",
                "section": "Sample Phrases"
            },
            "lines": [
                {
                    "script": "U+F0420 U+F0402 U+F0410 U+F040A U+0020 U+F0409 U+F0433 U+F0411 U+F0430 U+F040B U+F0408 U+F0430 U+F0450 U+0020 U+F0412 U+F040A U+F0438 U+F0409 U+F0430 U+F0400 U+F040A",
                    "roman": "Agarana dulipati, vandikana",
                    "english": "Honored elder, I show respect"
                },
                {
                    "script": "U+F0412 U+F0431 U+F0409 U+F0438 U+F040F U+F0410 U+F040E U+F0438 U+0020 U+F0408 U+F0430 U+F0412 U+F040F U+F0433 U+F0450 U+0020 U+F0408 U+F0410 U+F0406 U+F0430 U+F0414 U+F0433 U+F040E U+F0438",
                    "roman": "Vedyaram tivayu, tarajisum",
                    "english": "I dwell in Vedyaram, by birthright"
                },
                {
                    "script": "U+F040D U+F0400 U+F0438 U+F0408 U+F0430 U+F0410 U+F0438 U+0020 U+F0422 U+F0413 U+F0438 U+F0408 U+F040E U+F0430 U+0020 U+F0409 U+F0433 U+F0411 U+F0430 U+F0408 U+F0410",
                    "roman": "Bhaktir ushtami dulitara",
                    "english": "I hold devotion as my highest path"
                },
                {
                    "script": "U+F0412 U+F0414 U+F0438 U+F0408 U+F0433 U+F040A U+0020 U+F0400 U+F0410 U+F0438 U+F040E U+F0408 U+0020 U+F0412 U+F040A U+F0430 U+F0414",
                    "roman": "Vastuna karmata vanisa?",
                    "english": "May the transaction bring prosperity?"
                },
                {
                    "script": "U+F0410 U+F0430 U+F0408 U+F0433 U+F0408 U+0020 U+F0414 U+F040E U+F0410 U+F0438 U+F0412 U+F040A U+0020 U+F0422 U+F0413 U+F0438 U+F0408 U+F0430",
                    "roman": "Rituta samarvana ushti",
                    "english": "The observance is offered to the sacred order"
                }
            ],
