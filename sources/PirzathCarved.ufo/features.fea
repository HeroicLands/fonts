  pos base zh <anchor 296 -42> mark @DBL;
  pos base ts <anchor 283 -42> mark @DBL;
  pos base ch <anchor 229 -42> mark @DBL;
  pos base j <anchor 296 -42> mark @DBL;
  pos base q <anchor 296 -42> mark @DBL;
  pos base ng <anchor 172 -42> mark @DBL;
  pos base ny <anchor 336 -42> mark @DBL;
  pos base catch <anchor 182 -42> mark @DBL;
  pos base w <anchor 400 -42> mark @DBL;
  pos base y <anchor 400 -42> mark @DBL;
  pos base hl <anchor 273 -42> mark @DBL;
} mark;

