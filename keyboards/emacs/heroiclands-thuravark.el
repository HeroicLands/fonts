;;; Commentary:

;; An input method for the code points of Thuravark Carved.
;; Generated by tools/keyboards.py from fonts.json. Put this directory on
;; `load-path', evaluate (require 'heroiclands-thuravark), then M-x set-input-method.

;;; Code:

(require 'quail)

(quail-define-package
 "heroiclands-thuravark" "Thuravark" "HL-Thu" t
 "Type Thuravark Carved with the same keys as the macOS layout.
A letter types itself, Shift types the capital or the digraph on that key,
and Option has no Emacs key: Option+x is \\ and then the key
that x types, so Option+Shift+a is \\A.
The cheatsheet keyboards/thuravark.md lists every key."
 nil t nil nil nil nil nil nil nil nil t)

(quail-define-rules
 ("a" #xF0100)
 ("e" #xF0101)
 ("i" #xF0102)
 ("o" #xF0103)
 ("u" #xF0104)
 ("b" #xF0105)
 ("d" #xF0106)
 ("f" #xF0107)
 ("g" #xF0108)
 ("h" #xF0109)
 ("j" #xF010A)
 ("k" #xF010B)
 ("l" #xF010C)
 ("m" #xF010D)
 ("n" #xF010E)
 ("p" #xF010F)
 ("r" #xF0110)
 ("s" #xF0111)
 ("t" #xF0112)
 ("v" #xF0113)
 ("w" #xF0114)
 ("z" #xF0115)
 ("T" #xF0120)
 ("D" #xF0121)
 ("K" #xF0122)
 ("G" #xF0123)
 ("H" #xF0124)
 ("N" #xF0125)
 ("0" #xF0130)
 ("1" #xF0131)
 ("2" #xF0132)
 ("3" #xF0133)
 ("4" #xF0134)
 ("5" #xF0135)
 ("6" #xF0136)
 ("7" #xF0137)
 ("8" #xF0138)
 ("9" #xF0139)
 ("." #xF0140)
 ("\\e" #xF0148))

(provide 'heroiclands-thuravark)

