languagesystem DFLT dflt;
languagesystem latn dflt;

# HarfBuzz replaces a default-ignorable character the font maps directly with
# the space glyph. A glyph that a lookup substitutes is left alone, so each
# ignorable is substituted once, to a second empty glyph.
feature ccmp {
  sub ignorable by ignorable.sub;
} ccmp;

# A vowel and the length mark after it are drawn as the long vowel.
feature liga {
  sub a lengthmark by aacute;
  sub e lengthmark by eacute;
  sub i lengthmark by iacute;
  sub o lengthmark by oacute;
  sub u lengthmark by uacute;
} liga;

# A consonant written twice is the doubled sign.
feature rlig {
  sub p p by p_p;
  sub b b by b_b;
  sub f f by f_f;
  sub v v by v_v;
  sub t t by t_t;
  sub d d by d_d;
  sub t_h t_h by t_h_t_h;
  sub d_h d_h by d_h_d_h;
  sub k k by k_k;
  sub g g by g_g;
  sub k_h k_h by k_h_k_h;
  sub g_h g_h by g_h_g_h;
  sub m m by m_m;
  sub n n by n_n;
  sub ng ng by ng_ng;
  sub ny ny by ny_ny;
  sub s s by s_s;
  sub sh sh by sh_sh;
  sub z z by z_z;
  sub zh zh by zh_zh;
  sub l l by l_l;
  sub hl hl by hl_hl;
  sub r r by r_r;
  sub h h by h_h;
  sub catch catch by catch_catch;
  sub ts ts by ts_ts;
  sub ch ch by ch_ch;
  sub j j by j_j;
  sub q q by q_q;
  sub w w by w_w;
  sub y y by y_y;
} rlig;

markClass lengthmark <anchor 0 0> @LEN;

# A length mark left on a vowel pair stands over the middle of the pair.
feature mark {
  pos base ai <anchor 203 0> mark @LEN;
  pos base au <anchor 291 0> mark @LEN;
  pos base ei <anchor 322 0> mark @LEN;
  pos base oi <anchor 216 40> mark @LEN;
  pos base ou <anchor 358 0> mark @LEN;
} mark;
