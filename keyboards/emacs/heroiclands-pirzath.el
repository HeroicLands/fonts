;;; Commentary:

;; An input method for the code points of Pirzath Carved, Pirzath Hand, Pirzath Hand Lifted.
;; Generated by tools/keyboards.py from fonts.json. Put this directory on
;; `load-path', evaluate (require 'heroiclands-pirzath), then M-x set-input-method.

;;; Code:

(require 'quail)

(quail-define-package
 "heroiclands-pirzath" "Pirzath" "HL-Pir" t
 "Type Pirzath Carved, Pirzath Hand, Pirzath Hand Lifted with the same keys as the macOS layout.
A letter types itself, Shift types the capital or the digraph on that key,
and Option has no Emacs key: Option+x is \\ and then the key
that x types, so Option+Shift+a is \\A.
The cheatsheet keyboards/pirzath.md lists every key."
 nil t nil nil nil nil nil nil nil nil t)

(quail-define-rules
 ("a" #xF0000)
 ("e" #xF0001)
 ("i" #xF0002)
 ("o" #xF0003)
 ("u" #xF0004)
 ("p" #xF0005)
 ("b" #xF0006)
 ("f" #xF0007)
 ("v" #xF0008)
