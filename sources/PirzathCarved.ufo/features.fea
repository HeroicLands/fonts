  pos base n <anchor 330 -40> mark @DBL;
  pos base k <anchor 385 -40> mark @DBL;
  pos base g <anchor 385 -40> mark @DBL;
  pos base k_h <anchor 385 -40> mark @DBL;
  pos base g_h <anchor 385 -40> mark @DBL;
  pos base s <anchor 330 -40> mark @DBL;
  pos base z <anchor 330 -40> mark @DBL;
  pos base h <anchor 330 -40> mark @DBL;
  pos base l <anchor 297 -40> mark @DBL;
  pos base r <anchor 275 -40> mark @DBL;
  pos base sh <anchor 341 -40> mark @DBL;
  pos base zh <anchor 330 -40> mark @DBL;
  pos base ts <anchor 395 -40> mark @DBL;
  pos base ch <anchor 265 -40> mark @DBL;
  pos base j <anchor 330 -40> mark @DBL;
  pos base q <anchor 330 -40> mark @DBL;
  pos base ng <anchor 320 -40> mark @DBL;
  pos base ny <anchor 330 -40> mark @DBL;
  pos base catch <anchor 330 -40> mark @DBL;
  pos base w <anchor 430 -40> mark @DBL;
  pos base y <anchor 430 -40> mark @DBL;
  pos base hl <anchor 297 -40> mark @DBL;
} mark;

