languagesystem DFLT dflt;

# HarfBuzz replaces a default-ignorable character the font maps directly with
# the space glyph. A glyph that a lookup substitutes is left alone, so each
# ignorable is substituted once, to a second empty glyph.
feature ccmp {
  sub ignorable by ignorable.sub;
} ccmp;

@LET = [p v m t s n d dh k h ng l r carrier g th dhasp kh gh tej dej kej gej];
@LET_init = [p.init v.init m.init t.init s.init n.init d.init dh.init k.init h.init ng.init l.init r.init carrier.init g.init th.init dhasp.init kh.init gh.init tej.init dej.init kej.init gej.init];
@LET_medi = [p.medi v.medi m.medi t.medi s.medi n.medi d.medi dh.medi k.medi h.medi ng.medi l.medi r.medi carrier.medi g.medi th.medi dhasp.medi kh.medi gh.medi tej.medi dej.medi kej.medi gej.medi];
@LET_fina = [p.fina v.fina m.fina t.fina s.fina n.fina d.fina dh.fina k.fina h.fina ng.fina l.fina r.fina carrier.fina g.fina th.fina dhasp.fina kh.fina gh.fina tej.fina dej.fina kej.fina gej.fina];
@LET_init_wide = [p.init.wide v.init.wide m.init.wide t.init.wide s.init.wide n.init.wide d.init.wide dh.init.wide k.init.wide h.init.wide ng.init.wide l.init.wide r.init.wide carrier.init.wide g.init.wide th.init.wide dhasp.init.wide kh.init.wide gh.init.wide tej.init.wide dej.init.wide kej.init.wide gej.init.wide];
@LET_medi_wide = [p.medi.wide v.medi.wide m.medi.wide t.medi.wide s.medi.wide n.medi.wide d.medi.wide dh.medi.wide k.medi.wide h.medi.wide ng.medi.wide l.medi.wide r.medi.wide carrier.medi.wide g.medi.wide th.medi.wide dhasp.medi.wide kh.medi.wide gh.medi.wide tej.medi.wide dej.medi.wide kej.medi.wide gej.medi.wide];
@ANY = [p p.init p.medi p.fina p.init.wide p.medi.wide v v.init v.medi v.fina v.init.wide v.medi.wide m m.init m.medi m.fina m.init.wide m.medi.wide m.sweep m.fina.sweep m.ezh m.fina.ezh t t.init t.medi t.fina t.init.wide t.medi.wide s s.init s.medi s.fina s.init.wide s.medi.wide n n.init n.medi n.fina n.init.wide n.medi.wide n.sweep n.fina.sweep n.ezh n.fina.ezh d d.init d.medi d.fina d.init.wide d.medi.wide dh dh.init dh.medi dh.fina dh.init.wide dh.medi.wide k k.init k.medi k.fina k.init.wide k.medi.wide h h.init h.medi h.fina h.init.wide h.medi.wide ng ng.init ng.medi ng.fina ng.init.wide ng.medi.wide ng.sweep ng.fina.sweep ng.ezh ng.fina.ezh l l.init l.medi l.fina l.init.wide l.medi.wide r r.init r.medi r.fina r.init.wide r.medi.wide carrier carrier.init carrier.medi carrier.fina carrier.init.wide carrier.medi.wide g g.init g.medi g.fina g.init.wide g.medi.wide th th.init th.medi th.fina th.init.wide th.medi.wide dhasp dhasp.init dhasp.medi dhasp.fina dhasp.init.wide dhasp.medi.wide kh kh.init kh.medi kh.fina kh.init.wide kh.medi.wide gh gh.init gh.medi gh.fina gh.init.wide gh.medi.wide tej tej.init tej.medi tej.fina tej.init.wide tej.medi.wide dej dej.init dej.medi dej.fina dej.init.wide dej.medi.wide kej kej.init kej.medi kej.fina kej.init.wide kej.medi.wide gej gej.init gej.medi gej.fina gej.init.wide gej.medi.wide];
