  pos base g_h <anchor 400 -42> mark @DBL;
  pos base s <anchor 343 -42> mark @DBL;
  pos base z <anchor 343 -42> mark @DBL;
  pos base h <anchor 343 -42> mark @DBL;
  pos base l <anchor 309 -42> mark @DBL;
  pos base r <anchor 286 -42> mark @DBL;
  pos base sh <anchor 355 -42> mark @DBL;
  pos base zh <anchor 343 -42> mark @DBL;
  pos base ts <anchor 411 -42> mark @DBL;
  pos base ch <anchor 276 -42> mark @DBL;
  pos base j <anchor 343 -42> mark @DBL;
  pos base q <anchor 343 -42> mark @DBL;
  pos base ng <anchor 333 -42> mark @DBL;
  pos base ny <anchor 343 -42> mark @DBL;
  pos base catch <anchor 343 -42> mark @DBL;
  pos base w <anchor 447 -42> mark @DBL;
  pos base y <anchor 447 -42> mark @DBL;
  pos base hl <anchor 309 -42> mark @DBL;
} mark;

