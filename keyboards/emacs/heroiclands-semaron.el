;;; Commentary:

;; An input method for the code points of Semaron Kuriale.
;; Generated by tools/keyboards.py from fonts.json. Put this directory on
;; `load-path', evaluate (require 'heroiclands-semaron), then M-x set-input-method.

;;; Code:

(require 'quail)

(quail-define-package
 "heroiclands-semaron" "Semaron" "HL-Sem" t
 "Type Semaron Kuriale with the same keys as the macOS layout.
A letter types itself, Shift types the capital or the digraph on that key,
and Option has no Emacs key: Option+x is \\ and then the key
that x types, so Option+Shift+a is \\A.
The cheatsheet keyboards/semaron.md lists every key."
 nil t nil nil nil nil nil nil nil nil t)

