{
    "name": "@heroiclands/fonts",
    "version": "1.4.0",
    "description": "Fonts for the HeroicLands settings' scripts, drawn from scratch and licensed under the SIL OFL 1.1.",
    "license": "OFL-1.1",
    "type": "module",
    "exports": {
        "./fonts.css": "./fonts.css",
        "./fonts.json": "./fonts.json",
        "./fonts/*": "./fonts/*",
        "./package.json": "./package.json"
    },
    "files": [
        "fonts/*.woff2",
        "fonts/*.ttf",
        "fonts.css",
        "fonts.json",
        "charts",
        "LICENSE",
        "README.md"
    ],
    "devDependencies": {
        "@betteroffice/fonts": "^0.4.0",
        "@changesets/cli": "^3.0.3",
        "@heroiclands/package-build": "^25.2.0"
    },
    "scripts": {
        "test": "node --test tools/package_check.test.mjs",
        "format": "package-build format --write",
        "format:check": "package-build format",
        "check:package": "node tools/package_check.mjs",
        "changeset": "changeset",
        "changeset:version": "changeset version && package-build changelog group && npm install --package-lock-only",
        "prepare": "git config core.hooksPath .githooks || true"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HeroicLands/fonts.git"
    },
    "keywords": [
        "fonts",
        "heroiclands",
        "ofl",
        "woff2"
    ],
    "homepage": "https://github.com/HeroicLands/fonts#readme",
    "bugs": {
        "url": "https://github.com/HeroicLands/fonts/issues"
    }
}
