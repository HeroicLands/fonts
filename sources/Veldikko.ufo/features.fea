lookup barplace {
  lookupflag UseMarkFilteringSet @BAR;
  pos bar' <126 0 0 0> [carrier carrier.fina];
  pos bar' <139 0 0 0> [r r.fina];
  pos bar' <171 0 0 0> [carrier.init carrier.medi];
  pos bar' <183 0 0 0> [r.init r.medi];
  pos bar' <226 0 0 0> [l l.fina];
  pos bar' <256 0 0 0> [p p.fina v v.fina m m.fina m.sweep m.fina.sweep m.ezh m.fina.ezh];
  pos bar' <261 0 0 0> [k k.fina h h.fina ng ng.fina ng.sweep ng.fina.sweep ng.ezh ng.fina.ezh kh kh.fina kej kej.fina];
  pos bar' <270 0 0 0> [l.init l.medi];
  pos bar' <271 0 0 0> [g g.fina gh gh.fina gej gej.fina];
  pos bar' <295 0 0 0> [t t.fina s s.fina n n.fina n.sweep n.fina.sweep n.ezh n.fina.ezh th th.fina tej tej.fina];
  pos bar' <298 0 0 0> [d d.fina dh dh.fina dhasp dhasp.fina dej dej.fina];
  pos bar' <300 0 0 0> [p.init p.medi v.init v.medi m.init m.medi];
  pos bar' <306 0 0 0> [k.init k.medi h.init h.medi ng.init ng.medi kh.init kh.medi kej.init kej.medi];
  pos bar' <315 0 0 0> [g.init g.medi gh.init gh.medi gej.init gej.medi];
  pos bar' <340 0 0 0> [t.init t.medi s.init s.medi n.init n.medi th.init th.medi tej.init tej.medi];
  pos bar' <343 0 0 0> [d.init d.medi dh.init dh.medi dhasp.init dhasp.medi dej.init dej.medi];
  pos bar' <394 0 0 0> [carrier.init.wide carrier.medi.wide];
  pos bar' <406 0 0 0> [r.init.wide r.medi.wide];
  pos bar' <493 0 0 0> [l.init.wide l.medi.wide];
  pos bar' <523 0 0 0> [p.init.wide p.medi.wide v.init.wide v.medi.wide m.init.wide m.medi.wide];
  pos bar' <529 0 0 0> [k.init.wide k.medi.wide h.init.wide h.medi.wide ng.init.wide ng.medi.wide kh.init.wide kh.medi.wide kej.init.wide kej.medi.wide];
  pos bar' <538 0 0 0> [g.init.wide g.medi.wide gh.init.wide gh.medi.wide gej.init.wide gej.medi.wide];
  pos bar' <563 0 0 0> [t.init.wide t.medi.wide s.init.wide s.medi.wide n.init.wide n.medi.wide th.init.wide th.medi.wide tej.init.wide tej.medi.wide];
  pos bar' <566 0 0 0> [d.init.wide d.medi.wide dh.init.wide dh.medi.wide dhasp.init.wide dhasp.medi.wide dej.init.wide dej.medi.wide];
} barplace;

feature mark {
  lookup vowelplace;
  lookup diphthong;
  lookup barplace;
} mark;
