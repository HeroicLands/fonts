lookup forms {
  lookupflag IgnoreMarks;
  sub @ANY @LET' @ANY by @LET_medi;
  sub @ANY @LET' by @LET_init;
  sub @LET' @ANY by @LET_fina;
} forms;

lookup stretch {
  lookupflag UseMarkFilteringSet @V;
  sub @V @V [@LET_init @LET_medi]' by [@LET_init_wide @LET_medi_wide];
  sub @VSTRETCH [@LET_init @LET_medi]' by [@LET_init_wide @LET_medi_wide];
} stretch;

feature rclt {
  lookup vowels;
  lookup forms;
  lookup stretch;
} rclt;

feature ss01 {
  sub [m n ng m.fina n.fina ng.fina] by [m.sweep n.sweep ng.sweep m.fina.sweep n.fina.sweep ng.fina.sweep];
} ss01;

feature ss02 {
  sub [m n ng m.fina n.fina ng.fina] by [m.ezh n.ezh ng.ezh m.fina.ezh n.fina.ezh ng.fina.ezh];
} ss02;

feature salt {
  sub m from [m.sweep m.ezh];
  sub n from [n.sweep n.ezh];
  sub ng from [ng.sweep ng.ezh];
  sub m.fina from [m.fina.sweep m.fina.ezh];
  sub n.fina from [n.fina.sweep n.fina.ezh];
  sub ng.fina from [ng.fina.sweep ng.fina.ezh];
} salt;

lookup vowelplace {
  lookupflag UseMarkFilteringSet @V;
  pos @V' <-81 686 0 0> @V [l l.fina];
  pos @V' <-81 686 0 0> [l l.fina];
  pos @V' <-36 686 0 0> @V [l.init l.medi];
  pos @V' <-36 686 0 0> [l.init l.medi];
  pos @V' <126 686 0 0> @V [carrier carrier.fina];
  pos @V' <126 686 0 0> [carrier carrier.fina];
  pos @V' <139 686 0 0> @V [r r.fina];
  pos @V' <139 686 0 0> [r r.fina];
  pos @V' <171 686 0 0> @V [carrier.init carrier.medi];
  pos @V' <171 686 0 0> [carrier.init carrier.medi];
  pos @V' <183 686 0 0> @V [r.init r.medi];
  pos @V' <183 686 0 0> [r.init r.medi];
  pos @V' <187 686 0 0> @V [l.init.wide l.medi.wide];
  pos @V' <187 686 0 0> [l.init.wide l.medi.wide];
  pos @V' <256 686 0 0> @V [p p.fina v v.fina m m.fina m.sweep m.fina.sweep m.ezh m.fina.ezh];
  pos @V' <256 686 0 0> [p p.fina v v.fina m m.fina m.sweep m.fina.sweep m.ezh m.fina.ezh];
  pos @V' <261 755 0 0> @V [k k.fina h h.fina ng ng.fina ng.sweep ng.fina.sweep ng.ezh ng.fina.ezh kh kh.fina kej kej.fina];
  pos @V' <261 755 0 0> [k k.fina h h.fina ng ng.fina ng.sweep ng.fina.sweep ng.ezh ng.fina.ezh kh kh.fina kej kej.fina];
  pos @V' <271 686 0 0> @V [g g.fina gh gh.fina gej gej.fina];
  pos @V' <271 686 0 0> [g g.fina gh gh.fina gej gej.fina];
  pos @V' <295 686 0 0> @V [t t.fina s s.fina n n.fina n.sweep n.fina.sweep n.ezh n.fina.ezh th th.fina tej tej.fina];
  pos @V' <295 686 0 0> [t t.fina s s.fina n n.fina n.sweep n.fina.sweep n.ezh n.fina.ezh th th.fina tej tej.fina];
  pos @V' <298 755 0 0> @V [d d.fina dh dh.fina dhasp dhasp.fina dej dej.fina];
  pos @V' <298 755 0 0> [d d.fina dh dh.fina dhasp dhasp.fina dej dej.fina];
  pos @V' <300 686 0 0> @V [p.init p.medi v.init v.medi m.init m.medi];
  pos @V' <300 686 0 0> [p.init p.medi v.init v.medi m.init m.medi];
  pos @V' <306 755 0 0> @V [k.init k.medi h.init h.medi ng.init ng.medi kh.init kh.medi kej.init kej.medi];
  pos @V' <306 755 0 0> [k.init k.medi h.init h.medi ng.init ng.medi kh.init kh.medi kej.init kej.medi];
  pos @V' <315 686 0 0> @V [g.init g.medi gh.init gh.medi gej.init gej.medi];
  pos @V' <315 686 0 0> [g.init g.medi gh.init gh.medi gej.init gej.medi];
  pos @V' <340 686 0 0> @V [t.init t.medi s.init s.medi n.init n.medi th.init th.medi tej.init tej.medi];
  pos @V' <340 686 0 0> [t.init t.medi s.init s.medi n.init n.medi th.init th.medi tej.init tej.medi];
  pos @V' <343 755 0 0> @V [d.init d.medi dh.init dh.medi dhasp.init dhasp.medi dej.init dej.medi];
