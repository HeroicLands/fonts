
languagesystem DFLT dflt;
languagesystem latn dflt;

# Everything a closing quotation mark can follow: any glyph but a space or
# another quotation mark.
@AFTER = [.notdef p b f v m t d t_h d_h n k g k_h g_h s z h l r a u i e o sh zh ts ch j q ng ny catch w y hl ai au ei oi ou aacute uacute iacute eacute oacute lengthmark doubling num.0 num.1 num.2 num.3 num.4 num.5 num.6 num.7 num.8 num.9 num.10 num.11 num.12 num.13 num.14 num.15 hyphen period exclam comma less greater c];

# The vowels a glide y stands before.
@VOWEL = [a u i e o];

# A straight quotation mark opens after a space or at the start of the text,
# and closes elsewhere.
feature calt {
  sub @AFTER quotedbl' by quote.close;
  sub quotedbl' by quote.open;
} calt;

# A precomposed long vowel is the vowel and its length mark, and the first
# letter of a doubled digraph (tth, ddh, kkh, ggh, ssh, zzh, tts, nng, nny,
# hhl, cch) is the digraph itself, so that the ligature and the doubling rule
# below see two of the same letter.
feature ccmp {
lookup ccmp_long {
  sub aacute by a lengthmark;
  sub eacute by e lengthmark;
  sub iacute by i lengthmark;
  sub oacute by o lengthmark;
  sub uacute by u lengthmark;
} ccmp_long;
lookup ccmp_doubled {
  sub t' t h by t_h;
  sub d' d h by d_h;
  sub g' g h by g_h;
  sub k' k h by k_h;
  sub s' s h by sh;
  sub z' z h by zh;
  sub c' c h by ch;
  sub t' t s by ts;
  ignore sub n' n g h;
  sub n' n g by ng;
  sub n' n y by ny;
  sub h' h l by hl;
} ccmp_doubled;
} ccmp;

# The lookups run in order, so the longest spelling wins. The four digraphs
# come first, which makes ngh the letter n and gh; << and >> are the quotation
# marks. Then the lost consonants, then a y not before a vowel becomes the
# vowel i, then the five vowel pairs, which read through a length mark between
# their vowels; ay, ey and oy are the pairs ai, ei and oi.
feature liga {
lookup liga_digraphs {
  sub t h by t_h;
  sub d h by d_h;
  sub g h by g_h;
  sub k h by k_h;
  sub less less by quote.open;
  sub greater greater by quote.close;
} liga_digraphs;
lookup liga_lost {
  sub s h by sh;
  sub z h by zh;
  sub c h by ch;
  sub t s by ts;
  sub n g by ng;
  sub n y by ny;
  sub h l by hl;
} liga_lost;
lookup liga_y {
  ignore sub y' @VOWEL;
  sub y' by i;
} liga_y;
lookup liga_pairs {
  lookupflag IgnoreMarks;
  sub a i by ai;
  sub a u by au;
  sub e i by ei;
  sub o i by oi;
  sub o u by ou;
} liga_pairs;
} liga;

# A consonant written twice is the letter once with the doubling mark.
feature rlig {
  sub p p' by doubling;
  sub b b' by doubling;
  sub f f' by doubling;
  sub v v' by doubling;
  sub m m' by doubling;
  sub t t' by doubling;
  sub d d' by doubling;
  sub t_h t_h' by doubling;
  sub d_h d_h' by doubling;
  sub n n' by doubling;
  sub k k' by doubling;
  sub g g' by doubling;
  sub k_h k_h' by doubling;
  sub g_h g_h' by doubling;
  sub s s' by doubling;
  sub z z' by doubling;
  sub h h' by doubling;
  sub l l' by doubling;
  sub r r' by doubling;
  sub sh sh' by doubling;
  sub zh zh' by doubling;
  sub ts ts' by doubling;
  sub ch ch' by doubling;
  sub j j' by doubling;
  sub q q' by doubling;
  sub ng ng' by doubling;
  sub ny ny' by doubling;
  sub catch catch' by doubling;
  sub w w' by doubling;
  sub y y' by doubling;
  sub hl hl' by doubling;
} rlig;

table GDEF {
  GlyphClassDef [.notdef space p b f v m t d t_h d_h n k g k_h g_h s z h l r a u i e o sh zh ts ch j q ng ny catch w y hl ai au ei oi ou aacute uacute iacute eacute oacute num.0 num.1 num.2 num.3 num.4 num.5 num.6 num.7 num.8 num.9 num.10 num.11 num.12 num.13 num.14 num.15 hyphen period exclam comma quote.open quote.close quotedbl less greater c], , [lengthmark doubling], ;
} GDEF;

markClass lengthmark <anchor 0 0> @LEN;
markClass doubling <anchor 0 0> @DBL;

feature mark {
  pos base a <anchor 220 590> mark @LEN;
  pos base u <anchor 220 590> mark @LEN;
  pos base i <anchor 220 590> mark @LEN;
  pos base e <anchor 220 590> mark @LEN;
  pos base o <anchor 220 590> mark @LEN;
  pos base ai <anchor 220 590> mark @LEN;
  pos base au <anchor 220 590> mark @LEN;
  pos base ei <anchor 220 590> mark @LEN;
  pos base oi <anchor 220 590> mark @LEN;
  pos base ou <anchor 220 590> mark @LEN;
  pos base p <anchor 330 -40> mark @DBL;
  pos base b <anchor 330 -40> mark @DBL;
