        "hl-veldikko": {
            "tongue": "Sinale",
            "source": {
                "note": "assets/content/Skills/Languages/Sinale.md",
                "title": "Sinale Language",
                "section": "Sample Phrases"
            },
            "lines": [
                {
                    "script": "U+1ED5B U+1ED72 U+1ED78 U+1ED5C U+1ED71 U+0020 U+1ED55 U+1ED72 U+1ED78 U+1ED51 U+1ED70 U+0020 U+1ED5B U+1ED74 U+1ED54 U+1ED73 U+1ED5C U+1ED74 U+1ED59 U+1ED71",
                    "roman": "Luuro nuuva liseriho",
                    "english": "Starlight sings on still water"
                },
                {
                    "script": "U+1ED5B U+1ED74 U+0020 U+1ED54 U+1ED73 U+1ED53 U+1ED7C U+1ED75 U+0020 U+1ED5B U+1ED73 U+1ED55 U+1ED53 U+1ED74 U+0020 U+1ED53 U+1ED70 U+1ED5B U+1ED51 U+1ED73 U+1ED59 U+1ED71",
                    "roman": "Li-setty lenti talveho",
                    "english": "The tall grass stands in the low fog, as it always does"
                },
                {
                    "script": "U+1ED59 U+1ED70 U+0020 U+1ED53 U+1ED72 U+1ED50 U+1ED73 U+0020 U+1ED53 U+1ED74 U+1ED5B U+1ED51 U+1ED70 U+1ED74 U+0020 U+1ED59 U+1ED75 U+1ED54 U+1ED7C U+1ED73 U+1ED55",
                    "roman": "Ha-tupe tilvai hyssen",
                    "english": "The seam of light has held the breath"
                },
                {
                    "script": "U+1ED50 U+1ED73 U+1ED59 U+1ED73 U+1ED58 U+1ED70 U+0020 U+1ED59 U+1ED72 U+1ED71 U+1ED52 U+1ED70 U+1ED55 U+0020 U+1ED50 U+1ED73 U+1ED59 U+1ED73 U+1ED58 U+1ED70 U+0020 U+1ED55 U+1ED75 U+1ED5B U+1ED58 U+1ED74 U+1ED55",
                    "roman": "Peheka huoman, peheka nylkin",
                    "english": "Give warmth, give root"
                },
                {
                    "script": "U+1ED5B U+1ED72 U+1ED78 U+1ED5C U+1ED71 U+0020 U+1ED5D U+1ED74 U+1ED5B U+1ED73 U+1ED51 U+1ED70 U+0020 U+1ED5B U+1ED72 U+1ED78 U+1ED5C U+1ED71 U+0020 U+1ED5C U+1ED74 U+1ED51 U+1ED75",
                    "roman": "Luuro ileva, luuro rivy",
                    "english": "The clear place sings, the turning leaf sings"
                }
            ],
            "marks_note": "Each vowel is a mark floating over its letter, with its signs of length, pitch and emphasis folded into it.",
            "marks": [
                {
                    "label": "ta",
                    "script": "U+1ED53 U+1ED70"
                },
                {
                    "label": "to",
                    "script": "U+1ED53 U+1ED71"
                },
