# A block is matched whole, from its first item. A rule that ignores the block
# followed by another joiner leaves a block of more than two affixes in plain
# forms, and the first rule leaves what follows a joiner in plain forms, so no
# part of a rejected block is laid out as though it were a block of its own.
feature rclt {
  lookup block {
    ignore sub @JOIN @ALL';
    ignore sub @ITEM' @JB' @ITEM' @JB' @MAIN' @JOIN;
    sub @ITEM' lookup r_lead0 @JB' @ITEM' lookup r_lead1 @JB' @MAIN_full' lookup r_mLL;
    sub @ITEM' lookup r_lead0_double @JB' @ITEM' lookup r_lead1_double @JB' @MAIN_double' lookup r_mLL;
    ignore sub @SYL' @JS' @MAIN' @JS' @SYL' @JOIN;
    sub @SYL' lookup r_over0 @JS' @MAIN_full' lookup r_mOU @JS' @SYL' lookup r_under0;
    sub @SYL' lookup r_over0_double @JS' @MAIN_double' lookup r_mOU @JS' @SYL' lookup r_under0_double;
    ignore sub @ITEM' @JB' @SYL' @JS' @MAIN' @JOIN;
    sub @ITEM' lookup r_lead0 @JB' @SYL' lookup r_over1 @JS' @MAIN_full' lookup r_mLO;
    sub @ITEM' lookup r_lead0_double @JB' @SYL' lookup r_over1_double @JS' @MAIN_double' lookup r_mLO;
    ignore sub @ITEM' @JB' @MAIN' @JS' @SYL' @JOIN;
    sub @ITEM' lookup r_lead0 @JB' @MAIN_full' lookup r_mLU @JS' @SYL' lookup r_under1;
    sub @ITEM' lookup r_lead0_double @JB' @MAIN_double' lookup r_mLU @JS' @SYL' lookup r_under1_double;
    ignore sub @ITEM' @JB' @ITEM' @JB' @ITEM' @JOIN;
    sub @ITEM' lookup r_s3a @JB' @ITEM' lookup r_s3b @JB' @ITEM' lookup r_s3c;
    ignore sub @ITEM' @JB' @MAIN' @JOIN;
    sub @ITEM' lookup r_lead0 @JB' @MAIN_full' lookup r_mL;
    sub @ITEM' lookup r_lead0_double @JB' @MAIN_double' lookup r_mL;
    ignore sub @SYL' @JS' @MAIN' @JOIN;
    sub @SYL' lookup r_over0 @JS' @MAIN_full' lookup r_mO;
    sub @SYL' lookup r_over0_double @JS' @MAIN_double' lookup r_mO;
    ignore sub @MAIN' @JS' @SYL' @JOIN;
    sub @MAIN_full' lookup r_mU @JS' @SYL' lookup r_under0;
    sub @MAIN_double' lookup r_mU @JS' @SYL' lookup r_under0_double;
    ignore sub @ITEM' @JB' @ITEM' @JOIN;
    sub @ITEM' lookup r_s2a @JB' @ITEM' lookup r_s2b;
  } block;
} rclt;
