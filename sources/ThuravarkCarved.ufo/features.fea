languagesystem DFLT dflt;
languagesystem latn dflt;

# The face draws each character from its own code point. HarfBuzz replaces a
# default-ignorable character the font maps directly with the space glyph. A
# glyph that a lookup substitutes is left alone, so each ignorable is substituted
# once, to a second empty glyph. The acute mark after a vowel is drawn as the
# vowel's stave again.
feature ccmp {
  lookup ccmp_ignorable {
    sub ignorable by ignorable.sub;
  } ccmp_ignorable;
  lookup ccmp_acute {
    sub a acutecomb' by a.acute;
    sub e acutecomb' by e.acute;
    sub i acutecomb' by i.acute;
    sub o acutecomb' by o.acute;
    sub u acutecomb' by u.acute;
  } ccmp_acute;
} ccmp;

# The imperial recension binds a common pair of staves on one stem. The bound runes
# sit behind ss01, so plain text is unchanged.
feature ss01 {
  featureNames {
    name "Bound runes";
  };
  sub e n by e_n;
  sub e l by e_l;
  sub a r by a_r;
  sub a l by a_l;
  sub m a by m_a;
  sub z a by z_a;
  sub k a by k_a;
  sub u r by u_r;
  sub l m by l_m;
  sub l th by l_th;
} ss01;
