      "Dulkun putthák, Rinit dullák.": {"text": "󰀋󰀄󰀒󰀍󰀄󰀌 󰀅󰀄󰀠󰀠󰀀󰁠󰀍󰁑 󰀓󰀂󰀌󰀂󰀊 󰀋󰀄󰀒󰀒󰀀󰁠󰀍󰁐", "unmapped": [" ", " ", " "]},
      "Farz sudháv, dalk sudháv.": {"text": "󰀇󰀀󰀓󰀐 󰀏󰀄󰀡󰀀󰁠󰀈󰁑 󰀋󰀀󰀒󰀍 󰀏󰀄󰀡󰀀󰁠󰀈󰁐", "unmapped": [" ", " ", " "]},
      "Galdan Gald-vulád": {"text": "󰀎󰀀󰀒󰀋󰀀󰀌 󰀎󰀀󰀒󰀋󰁓󰀈󰀄󰀒󰀀󰁠󰀋", "unmapped": [" "]},
      "Galdan bunát, \"Dalík bant, maríg bant\".": {"text": "󰀎󰀀󰀒󰀋󰀀󰀌 󰀆󰀄󰀌󰀀󰁠󰀊󰁑 󰁔󰀋󰀀󰀒󰀂󰁠󰀍 󰀆󰀀󰀌󰀊󰁑 󰀉󰀀󰀓󰀂󰁠󰀎 󰀆󰀀󰀌󰀊󰁕󰁐", "unmapped": [" ", " ", " ", " ", " "]},
      "Gatharir tamík.": {"text": "󰀎󰀀󰀠󰀀󰀓󰀂󰀓 󰀊󰀀󰀉󰀂󰁠󰀍󰁐", "unmapped": [" "]},
      "Gaz Guruz, Tanv-guráz.": {"text": "󰀎󰀀󰀐 󰀎󰀄󰀓󰀄󰀐󰁑 󰀊󰀀󰀌󰀈󰁓󰀎󰀄󰀓󰀀󰁠󰀐󰁐", "unmapped": [" ", " "]},
      "Gaz bumár, gaz fuvád": {"text": "󰀎󰀀󰀐 󰀆󰀄󰀉󰀀󰁠󰀓󰁑 󰀎󰀀󰀐 󰀇󰀄󰀈󰀀󰁠󰀋", "unmapped": [" ", " ", " "]},
      "Gaz bunát, bant durákh.": {"text": "󰀎󰀀󰀐 󰀆󰀄󰀌󰀀󰁠󰀊󰁑 󰀆󰀀󰀌󰀊 󰀋󰀄󰀓󰀀󰁠󰀢󰁐", "unmapped": [" ", " ", " "]},
      "Gaz huváz.": {"text": "󰀎󰀀󰀐 󰀑󰀄󰀈󰀀󰁠󰀐󰁐", "unmapped": [" "]},
      "Gaz thumár, ves zummád.": {"text": "󰀎󰀀󰀐 󰀠󰀄󰀉󰀀󰁠󰀓󰁑 󰀈󰀁󰀏 󰀐󰀄󰀉󰀉󰀀󰁠󰀋󰁐", "unmapped": [" ", " ", " "]},
      "Gazn gulák nuv gatharir.": {"text": "󰀎󰀀󰀐󰀌 󰀎󰀄󰀒󰀀󰁠󰀍 󰀌󰀄󰀈 󰀎󰀀󰀠󰀀󰀓󰀂󰀓󰁐", "unmapped": [" ", " ", " "]},
      "Gazn.Gazn durákh tanv.": {"text": "󰀎󰀀󰀐󰀌󰁐󰀎󰀀󰀐󰀌 󰀋󰀄󰀓󰀀󰁠󰀢 󰀊󰀀󰀌󰀈󰁐", "unmapped": [" ", " "]},
